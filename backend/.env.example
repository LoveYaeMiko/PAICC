# PAICC backend environment. Copy to `.env` and fill in values.
# Every value can also be overridden at runtime via the Settings page (stored in SQLite).

# --- Quant project ---
PAICC_QUANT_ROOT=C:\Users\wyxwi\Desktop\FQA
PAICC_QUANT_CONFIG_FILE=configs/master_config.yaml
PAICC_QUANT_LOG_DIR=logs

# --- LLM (OpenAI-compatible providers: deepseek / openai / ollama / custom) ---
PAICC_LLM_PROVIDER=deepseek
PAICC_LLM_MODEL=deepseek-chat
PAICC_LLM_BASE_URL=https://api.deepseek.com
PAICC_LLM_API_KEY=
PAICC_LLM_TEMPERATURE=0.7

# --- Knowledge base / research ---
PAICC_KNOWLEDGE_THRESHOLD=0.5
PAICC_SEARCH_API_PROVIDER=
PAICC_SEARCH_API_KEY=

# --- Email (storage reports) ---
PAICC_SMTP_HOST=
PAICC_SMTP_PORT=465
PAICC_SMTP_USER=
PAICC_SMTP_PASSWORD=
PAICC_SMTP_FROM=
PAICC_SMTP_TO=

# --- Misc ---
PAICC_BACKEND_PORT=8000
# Everything command-line interface (es.exe); see https://www.voidtools.com/downloads/
PAICC_EVERYTHING_PATH=es.exe
# Claude Code CLI entry (claude.cmd on Windows); leave empty to resolve from PATH
PAICC_CLAUDE_PATH=
